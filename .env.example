# === Configuration du bot Telegram ===
# Tant que cette valeur modèle reste, le bot refuse de démarrer et dit quoi faire (comme le bot Python).
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
# TELEGRAM_API_URL=https://api.telegram.org
# Version affichée par /help (lue aussi par la CI pour les tags d'image)
VERSION=V10.0.0
DEVELOPED_BY=Tom V. | OverStyleFR

# === Accès ===
# Comme le bot Python d'origine : SANS ALLOWED_USER_IDS, le bot est ouvert à tous.
# ALLOWED_USER_IDS renseignée : seuls ces IDs (numériques) et les administrateurs l'utilisent.
# ALLOWED_USER_IDS=111111111,222222222
# ALLOW_ALL_USERS=1 force l'ouverture à tous même avec ALLOWED_USER_IDS
# IDs numériques administrateurs : /stats et /settings (ne restreint pas l'accès au bot)
# ADMIN_USER_IDS=111111111
RATE_LIMIT_PER_MIN=5

# === Limites ===
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILESIZE_MB=500
MAX_DURATION_S=3600
# Au-delà : repli externe. Le bot Python basculait à 35 Mo : mettre 35 pour le même seuil.
TELEGRAM_UPLOAD_LIMIT_MB=50

# === Fichiers et rétention (noms identiques à ceux du bot Python) ===
DOWNLOAD_DIR=./downloads
# Intervalle du nettoyage, en heures
CLEANUP_INTERVAL_HOURS=48
# Espace libre minimum en Mo avant nettoyage d'urgence (MIN_FREE_DISK_MB accepté aussi)
MIN_FREE_SPACE_MB=500
# Fichiers de moins de SMALL_FILE_SIZE_MB (et tous les mp3) : rétention « petits », sinon « gros »
SMALL_FILE_SIZE_MB=12
RETENTION_SMALL_HOURS=24
RETENTION_LARGE_HOURS=2
# RETENTION_HOURS=24 fixerait les deux d'un coup (ignoré si les deux lignes ci-dessus existent)
CACHE_TTL_H=24
HEARTBEAT_FILE=/tmp/svd-heartbeat

# === Outils ===
YTDLP_PATH=yt-dlp
# Un chemin inexistant (ex. ffmpeg/ffmpeg-7.0.2-amd64-static/ffmpeg du bot Python) : repli sur `ffmpeg` du PATH
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 0 = jamais de mise à jour automatique de yt-dlp
YTDLP_UPDATE_INTERVAL_H=24

# === Repli d'hébergement externe (fichier trop gros pour Telegram) ===
# Absente : curl.libriciel.fr, comme le bot Python. Vide ou off : repli coupé.
# EXTERNAL_UPLOAD_URL=https://curl.libriciel.fr/
# 1 = demander l'accord de l'utilisateur (boutons Oui/Non) avant l'envoi externe
# EXTERNAL_UPLOAD_CONSENT=0
EXTERNAL_UPLOAD_TIMEOUT_S=300

# === Journaux : console + un fichier par jour AAAA-MM-JJ.log, comme le bot Python ===
# LOGS_DIR=./logs
# LOG_FORMAT, RUST_LOG et NO_COLOR se lisent dans l'environnement du processus (voir README).

# === Tests/bancs seulement : désactive la garde anti-SSRF ===
UNSAFE_ALLOW_PRIVATE_HOSTS=0
