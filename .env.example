# === Bot Telegram (valeurs factices) ===
BOT_TOKEN=123456:REMPLACER_PAR_LE_TOKEN
# TELEGRAM_API_URL=https://api.telegram.org
# Version affichée (lue par la CI pour les tags d'image)
VERSION=V10.0.0

# === Accès ===
# IDs numériques Telegram séparés par des virgules ; vide = personne sauf ALLOW_ALL_USERS=1
ALLOWED_USER_IDS=111111111,222222222
ALLOW_ALL_USERS=0
# IDs numériques autorisés à /stats
ADMIN_USER_IDS=111111111
RATE_LIMIT_PER_MIN=5

# === Limites ===
MAX_CONCURRENT_DOWNLOADS=3
MAX_FILESIZE_MB=500
MAX_DURATION_S=3600
TELEGRAM_UPLOAD_LIMIT_MB=50

# === Fichiers et rétention ===
DOWNLOAD_DIR=./downloads
RETENTION_HOURS=24
MIN_FREE_DISK_MB=500
CACHE_TTL_H=24
HEARTBEAT_FILE=/tmp/svd-heartbeat

# === Outils ===
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# 0 = jamais de mise à jour automatique de yt-dlp
YTDLP_UPDATE_INTERVAL_H=24

# === Repli d'hébergement externe (absent = désactivé) ===
# EXTERNAL_UPLOAD_URL=https://hebergeur.example/upload
EXTERNAL_UPLOAD_TIMEOUT_S=300

# === Tests/bancs seulement : désactive la garde anti-SSRF ===
UNSAFE_ALLOW_PRIVATE_HOSTS=0
